# Published container image (set to ghcr.io/heklalab/gatearr:latest).
GATEARR_IMAGE=ghcr.io/heklalab/gatearr:latest
# Optional: Docker generates and persists secrets automatically when left blank.
APP_NAME=Gatearr
SECRET_KEY=
MEDIA_SERVER=emby
# Blank: the wizard proposes the URL used to reach the portal.
PUBLIC_URL=
COOKIE_SECURE=false
PORT=8000
BIND_ADDRESS=127.0.0.1
SYNC_INTERVAL_MINUTES=30
TRUSTED_PROXY_IPS=127.0.0.1
# HTTPS is handled by your existing reverse proxy. Set PUBLIC_URL=https://your-domain
# and COOKIE_SECURE=true, then configure TRUSTED_PROXY_IPS for that proxy.
