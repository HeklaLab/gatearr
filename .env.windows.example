# Published container image (set to ghcr.io/heklalab/gatearr:latest).
GATEARR_IMAGE=ghcr.io/heklalab/gatearr:latest
APP_NAME=Gatearr
SECRET_KEY=
PORT=8088
BIND_ADDRESS=127.0.0.1
PUBLIC_URL=http://localhost:8088
COOKIE_SECURE=false
SYNC_INTERVAL_MINUTES=30
TRUSTED_PROXY_IPS=127.0.0.1
# Existing installation only: set the previous data volume name to retain your data.
# GATEARR_DATA_VOLUME=
